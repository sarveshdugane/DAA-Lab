#include <stdio.h>
#include <stdlib.h>

void merge(int arr[], int temp[], int left, int mid, int right) {
    int i = left;      // Initial index for the left subarray
    int j = mid + 1;   // Initial index for the right subarray
    int k = left;      // Initial index for the merged temporary array
    
    // Merge elements from both halves in sorted order
    while (i <= mid && j <= right) {
        if (arr[i] <= arr[j]) {
            temp[k++] = arr[i++];
        } else {
            temp[k++] = arr[j++];
        }
    }
    
    // Copy remaining elements of the left half, if any
    while (i <= mid) {
        temp[k++] = arr[i++];
    }
    
    // Copy remaining elements of the right half, if any
    while (j <= right) {
        temp[k++] = arr[j++];
    }
    
    // Copy the sorted elements back into the original array
    for (i = left; i <= right; i++) {
        arr[i] = temp[i];
    }
}

void mergeSort(int arr[], int temp[], int left, int right) {
    if (left < right) {
        int mid = left + (right - left) / 2;
        
        // Sort first and second halves
        mergeSort(arr, temp, left, mid);
        mergeSort(arr, temp, mid + 1, right);
        
        // Merge the sorted halves
        merge(arr, temp, left, mid, right);
    }
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int *arr = (int *)malloc(n * sizeof(int));
    // Allocate a temporary buffer once to reuse across merges for O(n) space optimization
    int *temp = (int *)malloc(n * sizeof(int));
    
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Call mergeSort passing the temporary buffer
    mergeSort(arr, temp, 0, n - 1);

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    free(arr);
    free(temp);
    return 0;
}

