#include <stdio.h>
#include <stdlib.h>
#define MAX 99

struct node {
    int vertex;
    struct node* next;
};
typedef struct node* GNODE;

GNODE graph[20];
int visited[20];
int queue[MAX], front = -1, rear = -1;
int n;

void insertQueue(int vertex) {
    if (rear == MAX - 1)
        printf("Queue Overflow.\n");
    else {
        if (front == -1)
            front = 0;
        rear++;
        queue[rear] = vertex;
    }
}

int isEmptyQueue() {
    return (front == -1 || front > rear);
}

int deleteQueue() {
    if (isEmptyQueue()) {
        printf("Queue Underflow\n");
        exit(1);
    }
    return queue[front++];
}

// Function to add a directed edge to the adjacency list
void addEdge(int src, int dest) {
    GNODE newNode = (GNODE)malloc(sizeof(struct node));
    newNode->vertex = dest;
    newNode->next = NULL;

    // Insert at the end of the list to maintain input ordering for BFS traversal
    if (graph[src] == NULL) {
        graph[src] = newNode;
    } else {
        GNODE temp = graph[src];
        while (temp->next != NULL) {
            temp = temp->next;
        }
        temp->next = newNode;
    }
}

// Core BFS Traversal implementation
void bfs(int startVertex) {
    // Mark the starting node as visited and push it into the queue
    visited[startVertex] = 1;
    insertQueue(startVertex);

    while (!isEmptyQueue()) {
        // Dequeue a vertex and print it on a new line
        int currentVertex = deleteQueue();
        printf("%d\n", currentVertex);

        // Traverse all adjacent neighbors of the current vertex
        GNODE temp = graph[currentVertex];
        while (temp != NULL) {
            int adjVertex = temp->vertex;
            if (!visited[adjVertex]) {
                visited[adjVertex] = 1;
                insertQueue(adjVertex);
            }
            temp = temp->next;
        }
    }
}

int main() {
    int edges, src, dest, startVertex;

    printf("Enter the number of vertices: ");
    if (scanf("%d", &n) != 1) return 0;

    printf("Enter the number of edges: ");
    if (scanf("%d", &edges) != 1) return 0;

    // Initialize all adjacency lists to NULL and visited states to 0
    for (int i = 0; i <= n; i++) {
        graph[i] = NULL;
        visited[i] = 0;
    }

    // Read all source and destination edge pairs
    for (int i = 0; i < edges; i++) {
        printf("Enter source: ");
        scanf("%d", &src);
        printf("Enter destination: ");
        scanf("%d", &dest);
        addEdge(src, dest);
    }

    printf("Enter Start Vertex for BFS: ");
    scanf("%d", &startVertex);

    printf("BFS of graph: \n");
    bfs(startVertex);

    // Free the allocated memory for the adjacency list
    for (int i = 0; i <= n; i++) {
        GNODE temp = graph[i];
        while (temp != NULL) {
            GNODE toFree = temp;
            temp = temp->next;
            free(toFree);
        }
    }

    return 0;
}


