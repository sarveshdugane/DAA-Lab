#include <stdio.h>
#include <stdlib.h>

int main() {
    int m, n;
    // Read dimensions of Matrix A
    if (scanf("%d %d", &m, &n) != 2) {
        printf("Invalid input\n");
        return 0;
    }

    // Allocate and read Matrix A
    int matrix_a[m][n];
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            if (scanf("%d", &matrix_a[i][j]) != 1) {
                printf("Invalid input\n");
                return 0;
            }
        }
    }

    int n_b, p;
    // Read dimensions of Matrix B
    if (scanf("%d %d", &n_b, &p) != 2) {
        printf("Invalid input\n");
        return 0;
    }

    // Skip reading elements and print error if dimensions do not match
    if (n != n_b) {
        printf("Invalid input\n");
        return 0;
    }

    // Proceed to read Matrix B since dimensions match
    int matrix_b[n_b][p];
    for (int i = 0; i < n_b; i++) {
        for (int j = 0; j < p; j++) {
            if (scanf("%d", &matrix_b[i][j]) != 1) {
                printf("Invalid input\n");
                return 0;
            }
        }
    }

    // Initialize result matrix with zeros
    int result[m][p];
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            result[i][j] = 0;
        }
    }

    // Perform matrix multiplication
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            for (int k = 0; k < n; k++) {
                result[i][j] += matrix_a[i][k] * matrix_b[k][j];
            }
        }
    }

    // Display the resulting product matrix with a trailing space
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            printf("%d ", result[i][j]); // Modified to print a space after every number
        }
        printf("\n");
    }

    return 0;
}

