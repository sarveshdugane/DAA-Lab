#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

// Structure to store a subset for reverse-order printing
typedef struct {
    int* elements;
    int size;
} Subset;

// Global tracking variables
Subset* results = NULL;
int result_count = 0;
int result_capacity = 0;

// Helper function to add a discovered subset to the results array
void storeSubset(int current_subset[], int subset_size) {
    if (result_count >= result_capacity) {
        result_capacity = result_capacity == 0 ? 10 : result_capacity * 2;
        results = (Subset*)realloc(results, result_capacity * sizeof(Subset));
    }
    
    results[result_count].elements = (int*)malloc(subset_size * sizeof(int));
    results[result_count].size = subset_size;
    
    for (int i = 0; i < subset_size; i++) {
        results[result_count].elements[i] = current_subset[i];
    }
    result_count++;
}

// Backtracking function to find subsets
void findSubsets(int arr[], int n, int target_sum, int index, int current_sum, int current_subset[], int subset_size) {
    // If the target sum is reached, store the current configuration and return immediately
    if (current_sum == target_sum) {
        storeSubset(current_subset, subset_size);
        return; // FIXED: Prevents further processing of this branch which causes the duplication
    }
    
    // Base conditions for stopping
    if (index == n || current_sum > target_sum) {
        return;
    }

    // Choice 1: Include the current element
    current_subset[subset_size] = arr[index];
    findSubsets(arr, n, target_sum, index + 1, current_sum + arr[index], current_subset, subset_size + 1);

    // Choice 2: Exclude the current element
    findSubsets(arr, n, target_sum, index + 1, current_sum, current_subset, subset_size);
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int target_sum;
    scanf("%d", &target_sum);

    int* current_subset = (int*)malloc(n * sizeof(int));

    // Start backtracking from index 0 with an initial sum of 0
    findSubsets(arr, n, target_sum, 0, 0, current_subset, 0);

    // If no subsets were found, print -1
    if (result_count == 0) {
        printf("-1\n");
    } else {
        // Print the subsets in reverse order of their discovery
        for (int i = result_count - 1; i >= 0; i--) {
            for (int j = 0; j < results[i].size; j++) {
                printf("%d", results[i].elements[j]);
                if (j < results[i].size - 1) {
                    printf(" ");
                }
            }
            printf(" \n"); // Matches trailing space and newline structure from test cases
            free(results[i].elements);
        }
    }

    // Free all allocated memory
    free(results);
    free(current_subset);
    free(arr);

    return 0;
}

