#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

// Helper function to find the set/component of an element i
int findParent(int i, int parent[]) {
    while (parent[i] != i)
        i = parent[i];
    return i;
}

// Helper function to perform union of two sets
void unionSets(int i, int j, int parent[]) {
    int root_i = findParent(i, parent);
    int root_j = findParent(j, parent);
    parent[root_i] = root_j;
}

void kruskalMST(int **cost, int V) {
    int *parent = (int *)malloc(V * sizeof(int));
    
    // Initialize each vertex as its own parent set
    for (int i = 0; i < V; i++)
        parent[i] = i;

    int edge_count = 0;
    int min_cost = 0;

    // Loop until we include exactly V-1 edges in the MST
    while (edge_count < V - 1) {
        int min = 9999;
        int u = -1, v = -1;

        // Find the minimum weight edge from the upper triangular matrix
        // By looking row-wise (i from 0 to V, j from i+1 to V), we preserve 
        // the original row-wise order tie-breaker required by the problem statement.
        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {
                if (cost[i][j] < min) {
                    min = cost[i][j];
                    u = i;
                    v = j;
                }
            }
        }

        // If no valid edge is found, break to prevent an infinite loop
        if (u == -1 || v == -1) break;

        // Check if including this edge creates a cycle
        if (findParent(u, parent) != findParent(v, parent)) {
            printf("Edge %d:(%d, %d) cost:%d\n", edge_count, u, v, min);
            min_cost += min;
            unionSets(u, v, parent);
            edge_count++;
        }

        // Mark the edge as processed so it isn't picked again
        cost[u][v] = cost[v][u] = 9999;
    }

    printf("Minimum cost= %d\n", min_cost);
    free(parent);
}

int main() {
    int V;
    printf("No of vertices: ");
    if (scanf("%d", &V) != 1) return 0;

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
