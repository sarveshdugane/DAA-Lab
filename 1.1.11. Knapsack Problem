#include <stdio.h>
#include <stdlib.h>

// Helper function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n, W;

    // Read the number of items
    if (scanf("%d", &n) != 1) return 0;

    int *values = (int *)malloc(n * sizeof(int));
    int *weights = (int *)malloc(n * sizeof(int));

    // Read the values of the items
    for (int i = 0; i < n; i++) {
        scanf("%d", &values[i]);
    }

    // Read the weights of the items
    for (int i = 0; i < n; i++) {
        scanf("%d", &weights[i]);
    }

    // Read the maximum knapsack capacity
    scanf("%d", &W);

    // dp[w] will store the maximum value achieved with a knapsack capacity of w
    // Using a 1D array optimized space from O(N*W) to O(W)
    int *dp = (int *)calloc(W + 1, sizeof(int));

    // Build the DP table in a bottom-up manner
    for (int i = 0; i < n; i++) {
        // Traverse the capacity array backwards to avoid re-using the current item
        for (int w = W; w >= weights[i]; w--) {
            dp[w] = max(dp[w], dp[w - weights[i]] + values[i]);
        }
    }

    // Print the maximum total value achieved
    printf("%d\n", dp[W]);

    // Free all dynamically allocated memory
    free(values);
    free(weights);
    free(dp);

    return 0;
}

